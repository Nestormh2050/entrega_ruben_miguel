# ============================================================
# Credenciales de MariaDB (Docker)
# Copia este archivo a .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# Contraseña del usuario root
MARIADB_ROOT_PASSWORD=cambia_esta_password

# Base de datos inicial (se crea al primer arranque)
MARIADB_DATABASE=appdb

# Usuario de aplicación y su contraseña
MARIADB_USER=appuser
MARIADB_PASSWORD=cambia_esta_password_de_app

# Puerto del host (por defecto 3305)
HOST_PORT=3305
