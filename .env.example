MARIADB_ROOT_PASSWORD=<CAMBIAR_ROOT_PASSWORD>
MARIADB_DATABASE=neology_parking
MARIADB_USER=parking_app
MARIADB_PASSWORD=<CAMBIAR_APP_PASSWORD>
HOST_PORT=3305