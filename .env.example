# ============================================================
# Credenciales MariaDB — Neology Parking
# Copia este archivo a .env y define tus valores.
# NUNCA subas .env al repositorio.
# ============================================================

MARIADB_ROOT_PASSWORD=<CAMBIAR_ROOT_PASSWORD>
MARIADB_DATABASE=neology_parking
MARIADB_USER=parking_app
MARIADB_PASSWORD=<CAMBIAR_APP_PASSWORD>
HOST_PORT=3305

# Credenciales de los usuarios de trabajo (security.sql)
# Deben coincidir con las que se definan en .env real
MARIADB_REPORT_PASSWORD=<CAMBIAR_REPORT_PASSWORD>
MARIADB_OPS_PASSWORD=<CAMBIAR_OPS_PASSWORD>
MARIADB_DBA_PASSWORD=<CAMBIAR_DBA_PASSWORD>